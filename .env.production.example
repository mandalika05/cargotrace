# Contoh nilai production (P15). JANGAN isi rahasia asli di file ini; isi di dashboard hosting (Render > Environment).
APP_NAME=CargoTrace
APP_ENV=production
APP_DEBUG=false
APP_KEY=                    # buat di laptop: php artisan key:generate --show  (hasilnya diawali base64:)
APP_URL=https://cargotrace.onrender.com

LOG_CHANNEL=stderr

DB_CONNECTION=mysql
DB_HOST=                    # dari TiDB Cloud > Connect
DB_PORT=4000
DB_DATABASE=cargotrace
DB_USERNAME=
DB_PASSWORD=
MYSQL_ATTR_SSL_CA=/etc/ssl/certs/ca-certificates.crt

SESSION_DRIVER=database
CACHE_STORE=database
QUEUE_CONNECTION=sync
SESSION_SECURE_COOKIE=true

SHOW_DEMO_ACCOUNTS=true     # dosen butuh akun demo
RUN_MIGRATIONS=true
SEED_DEMO=true              # data demo hanya diisi bila database kosong
